{
  "name": "bsdynamodb",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:admin": "dynamodb-admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "import": "node scripts/import.mjs",
    "docker:build": "docker build -t imis/$npm_package_name:$npm_package_version -t imis/$npm_package_name:latest .",
    "docker:push": "docker push imis/$npm_package_name:$npm_package_version && docker push imis/$npm_package_name:latest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "mongodb": "^7.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@nestjs/cli": "^11.0.23",
    "@types/express": "^5.0.6",
    "@types/node": "^24.11.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "dynamodb-admin": "^5.3.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "vitest": "^4.1.8"
  }
}
